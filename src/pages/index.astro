---
import { resume } from '../data/resume';

const { basics, work } = resume;

function formatDate(d: string | null): string {
  if (d === null) return 'Present';
  const [year, month] = d.split('-');
  if (!month) return year;
  const name = new Date(Number(year), Number(month) - 1).toLocaleString('en-US', { month: 'short' });
  return `${name} ${year}`;
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{basics.name} — {basics.label}</title>
    <meta name="description" content={basics.summary} />
  </head>
  <body>
    <h1>{basics.name}</h1>
    <p>{basics.label}</p>
    <p>{basics.summary}</p>

    <h2>Experience</h2>
    {work.map((job) => (
      <article>
        <h3>{job.position}</h3>
        <p>{job.name} · {formatDate(job.startDate)} – {formatDate(job.endDate)}</p>
        <ul>
          {job.highlights.map((h) => <li>{h}</li>)}
        </ul>
      </article>
    ))}
  </body>
</html>