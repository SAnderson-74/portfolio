---
import "@fontsource-variable/archivo";
import "@fontsource-variable/source-serif-4/wght.css";
import "../styles/global.css";
import { resume } from "../data/resume";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const { basics } = resume;

const nav = [
  { href: "/", label: "Overview" },
  { href: "/projects/", label: "Projects" },
];

const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="page masthead__inner">
        <a class="masthead__name" href="/">{basics.name}</a>
        <nav aria-label="Main">
          <ul class="masthead__nav">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={path === item.href ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="page">
      <slot />
    </main>

    <footer class="colophon">
      <div class="page rail">
        <p class="rail__label">Contact</p>
        <div>
          <ul class="colophon__links">
            <li><a href={`mailto:${basics.email}`}>{basics.email}</a></li>
            {
              basics.profiles.map((profile) => (
                <li>
                  <a href={profile.url}>{profile.network}</a>
                </li>
              ))
            }
          </ul>
          <p class="colophon__note">
            Built with Astro. Self-hosted and served from a home rack.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }

  .skip:focus {
    left: var(--space-4);
    top: var(--space-4);
    z-index: 10;
    background: var(--paper-raised);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--rule-strong);
  }

  .masthead {
    border-bottom: 1px solid var(--rule);
  }

  .masthead__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .masthead__name {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }

  .masthead__nav {
    display: flex;
    gap: var(--space-6);
    list-style: none;
    padding: 0;
    font-family: var(--font-display);
    font-size: var(--text-sm);
  }

  .masthead__nav a {
    color: var(--ink-soft);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
  }

  .masthead__nav a:hover {
    color: var(--ink);
    border-bottom-color: var(--rule-strong);
  }

  .masthead__nav a[aria-current="page"] {
    color: var(--ink);
    border-bottom-color: var(--signal);
  }

  main {
    padding-block: var(--space-16) var(--space-24);
  }

  .colophon {
    border-top: 1px solid var(--rule);
    padding-block: var(--space-8);
  }

  .colophon__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    list-style: none;
    padding: 0;
    font-family: var(--font-display);
    font-size: var(--text-sm);
  }

  .colophon__note {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--ink-faint);
  }
</style>
