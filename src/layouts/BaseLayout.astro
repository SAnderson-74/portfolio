---
import "@fontsource-variable/archivo";
import "@fontsource-variable/source-serif-4/wght.css";
import "../styles/global.css";
import { resume } from "../data/resume";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const { basics } = resume;

const nav = [
  { href: "/", label: "Overview" },
  { href: "/projects/", label: "Projects" },
];

const path = Astro.url.pathname;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    {/* Runs before the browser paints. is:inline keeps Astro from bundling
        and deferring it — a deferred version would run after first paint,
        which is exactly the flash this exists to prevent. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="page masthead__inner">
        <a class="masthead__name" href="/">{basics.name}</a>
        <div class="masthead__right">
          <nav aria-label="Main">
            <ul class="masthead__nav">
              {
                nav.map((item) => (
                  <li>
                    <a href={item.href} aria-current={path === item.href ? "page" : undefined}>
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>

          <button type="button" class="theme" data-theme-toggle aria-label="Switch theme">
            <svg class="theme__sun" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="10" cy="10" r="3.6" stroke="currentColor" stroke-width="1.3"></circle>
              <path
                d="M10 1.6v2.2M10 16.2v2.2M18.4 10h-2.2M3.8 10H1.6M15.94 4.06l-1.56 1.56M5.62 14.38l-1.56 1.56M15.94 15.94l-1.56-1.56M5.62 5.62L4.06 4.06"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linecap="round"></path>
            </svg>
            <svg class="theme__moon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path
                d="M16.4 12.6A7 7 0 0 1 7.4 3.6a7 7 0 1 0 9 9Z"
                stroke="currentColor"
                stroke-width="1.3"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main" class="page">
      <slot />
    </main>

    <footer class="colophon">
      <div class="page colophon__inner">
        <div class="colophon__block">
          <h2 class="colophon__heading">Contact</h2>
          <ul class="colophon__links">
            <li><a href={`mailto:${basics.email}`}>{basics.email}</a></li>
            {
              basics.profiles.map((profile) => (
                <li>
                  <a href={profile.url}>{profile.network}</a>
                </li>
              ))
            }
          </ul>
        </div>

        {/* The infrastructure note. It is here because it is true and because
            it is the most relevant thing about this site to the people it is
            written for. */}
        <div class="colophon__block">
          <h2 class="colophon__heading">This site</h2>
          <dl class="colophon__spec">
            <div>
              <dt>Built with</dt>
              <dd>Astro, Caddy, Docker</dd>
            </div>
            <div>
              <dt>Hosted on</dt>
              <dd>Dell PowerEdge R640, TrueNAS SCALE</dd>
            </div>
            <div>
              <dt>Served via</dt>
              <dd>Cloudflare Tunnel — no inbound ports</dd>
            </div>
            <div>
              <dt>Deployed by</dt>
              <dd>GitHub Actions to GHCR</dd>
            </div>
          </dl>
          <p class="colophon__more">
            <a href="/projects/this-site/">How it was built</a>
          </p>
        </div>
      </div>

      <div class="page colophon__base">
        <p>© {year} {basics.name}</p>
        <p>
          Portions of this site and its write-ups were developed with Claude, Anthropic's AI
          assistant. Design decisions, infrastructure, and technical claims are my own and
          verified.
        </p>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

      function label() {
        if (!button) return;
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        button.setAttribute("aria-label", `Switch to ${next} theme`);
      }

      button?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        localStorage.setItem("theme", next);
        label();
      });

      label();
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
  }

  .skip:focus {
    left: var(--space-4);
    top: var(--space-4);
    z-index: 10;
    background: var(--paper-raised);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--rule-strong);
  }

  .masthead {
    border-bottom: 1px solid var(--rule);
    flex: 0 0 auto;
  }

  .masthead__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  .masthead__right {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .masthead__name {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
  }

  .masthead__nav {
    display: flex;
    gap: var(--space-6);
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-sm);
  }

  .masthead__nav a {
    color: var(--ink-soft);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
  }

  .masthead__nav a:hover {
    color: var(--ink);
    border-bottom-color: var(--rule-strong);
  }

  .masthead__nav a[aria-current="page"] {
    color: var(--ink);
    border-bottom-color: var(--signal);
  }

  .theme {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    padding: 0;
    background: none;
    border: 1px solid var(--rule);
    border-radius: 2px;
    color: var(--ink-soft);
    cursor: pointer;
    transition:
      color 120ms ease,
      border-color 120ms ease;
  }

  .theme:hover {
    color: var(--ink);
    border-color: var(--rule-strong);
  }

  .theme svg {
    width: 1rem;
    height: 1rem;
  }

  /* Show the icon for the theme you would switch TO, not the current one. */
  .theme__moon {
    display: none;
  }

  :root[data-theme="dark"] .theme__sun {
    display: none;
  }

  :root[data-theme="dark"] .theme__moon {
    display: block;
  }

  /* main grows; the footer is pushed to the bottom of the viewport when the
     page is short, and sits after the content when it is not. */
  main {
    flex: 1 0 auto;
    padding-block: var(--space-16) var(--space-24);
  }

  .colophon {
    flex: 0 0 auto;
    border-top: 1px solid var(--rule);
    padding-block: var(--space-12) var(--space-8);
  }

  .colophon__inner {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 52rem) {
    .colophon__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: var(--rail-gap);
    }
  }

  .colophon__heading {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink-faint);
    margin-bottom: var(--space-3);
  }

  .colophon__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    font-family: var(--font-display);
    font-size: var(--text-sm);
  }

  .colophon__spec {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    border-top: 1px solid var(--rule);
  }

  .colophon__spec > div {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0 var(--space-4);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 34rem) {
    .colophon__spec > div {
      grid-template-columns: 7rem minmax(0, 1fr);
    }
  }

  .colophon__spec dt {
    color: var(--ink-faint);
  }

  .colophon__spec dd {
    margin: 0;
    color: var(--ink-soft);
  }

  .colophon__more {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-sm);
  }

  .colophon__base {
    margin-top: var(--space-12);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--ink-faint);
  }

  .colophon__base p {
    max-width: 44rem;
  }
</style>
